#!/bin/bash
set -eu

source /usr/share/yunohost/helpers
source "$(dirname "$0")/_common.sh"

ynh_script_progression "Stopping Alby Hub..."
ynh_systemctl --service="$service_name" --action=stop --log_path=systemd || true

ynh_script_progression "Removing Nginx configuration..."
ynh_config_remove_nginx

ynh_script_progression "Removing systemd service..."
ynh_config_remove_systemd "$service_name"
yunohost service remove "$service_name" || true

ynh_script_progression "Removing Alby Hub binary..."
ynh_safe_rm "$install_dir"

# `data_dir` is managed by YunoHost's v2 resource lifecycle. It is retained
# for a normal removal and deprovisioned by YunoHost only when the administrator
# passes `--purge`; do not remove it from this hook, which also runs during
# safety-restore and remove-after-failure workflows.
ynh_script_progression "Alby Hub removal completed"
