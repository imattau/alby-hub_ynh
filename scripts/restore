#!/bin/bash
set -eu

source /usr/share/yunohost/helpers
source "$(dirname "$0")/_common.sh"

ynh_script_progression "Restoring persistent data..."
ynh_restore "$data_dir"
chown -R "$app:$app" "$data_dir"
chmod 750 "$data_dir"

ynh_script_progression "Reinstalling systemd service..."
yunohost service add "$service_name" --description="Alby Hub self-hosted Lightning wallet (HTTP mode)" --log="$alby_log_path" || true
ynh_config_add_systemd

ynh_script_progression "Reinstalling Nginx configuration..."
ynh_config_add_nginx

ynh_script_progression "Starting Alby Hub..."
ynh_systemctl --service="$service_name" --action=start --wait_until="http server started" --log_path=systemd --timeout=60

ynh_script_progression "Verifying health..."
i=0
until curl -sf -o /dev/null "http://127.0.0.1:$port/" 2>/dev/null; do
	i=$((i + 1))
	if [ "$i" -ge 30 ]; then
		ynh_die "Alby Hub did not answer on 127.0.0.1:$port within 30s after restore"
	fi
	sleep 1
done

ynh_script_progression "Alby Hub restore completed"
ynh_alby_display_url
ynh_print_info "Verify the wallet is recognised (see doc/BACKUP.md restore checklist)."
